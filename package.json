{
  "name": "@freya-vivariums/freya-logic-nodes-node-red-contrib",
  "version": "0.0.5",
  "description": "Node-RED logic nodes for the Freya Vivarium Control System",
  "author": "Sanne 'SpuQ' Santens",
  "license": "GPL-3.0",
  "homepage": "https://github.com/Freya-Vivariums",
  "bugs": {
    "url": "https://www.reddit.com/r/FreyaVivariums"
  },
  "private": false,
  "keywords": [
    "node-red",
    "node-red-node",
    "freya",
    "vivarium",
    "control system",
    "paludarium",
    "terrarium",
    "greenhouse"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "bash ./scripts/build.sh",
    "deploy": "bash ./scripts/deploy.sh && rm -rf build/",
