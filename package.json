  },
  "node-red": {
    "version": ">=4.0.9",
    "nodes": {
      "circadian-core": "build/nodes/circadian-core/circadian-core-node.js",
      "location-config": "build/nodes/circadian-core/location-config-node.js",
      "humidity-controller": "build/nodes/humidity-controller/humidity-controller-node.js",
      "lighting-controller": "build/nodes/lighting-controller/lighting-controller-node.js",
      "precipitation-controller": "build/nodes/precipitation-controller/precipitation-controller-node.js",
      "temperature-controller": "build/nodes/temperature-controller/temperature-controller-node.js",
      "status-aggregator": "build/nodes/status-aggregator/status-aggregator-node.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "build/icons",
    "build/nodes"
  ],
  "devDependencies": {
    "@types/node-red": "^1.3.5",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2"
  },
  "dependencies": {}
}
